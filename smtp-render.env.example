# Copiar a smtp-render.env (NO subir a Git). Usar con scripts/configurar-smtp-render.ps1

RESEND_API_KEY=re_xxxxxxxx
RESEND_SANDBOX=true
# Correo de la cuenta Resend (donde llegan pruebas en sandbox):
RESEND_SANDBOX_INBOX=tu-correo@gmail.com
# Cuando el dominio esté verificado en Resend:
# RESEND_SANDBOX=false
# RESEND_FROM_EMAIL=notificaciones@ferragro.com

SMTP_PROFILE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=contraseña-de-aplicacion-gmail
SMTP_FROM_EMAIL=tu-correo@gmail.com
SMTP_FROM_NAME=Ferragro
SMTP_USE_TLS=true
SMTP_USE_SSL=false
