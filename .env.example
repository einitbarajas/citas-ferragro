# Copia a .env en la raíz del repo (local) o configura las mismas variables en Render.
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/db_trabajo
SECRET_KEY=genera-un-secreto-largo-y-aleatorio

# Producción (Render): orígenes HTTPS del front en Vercel (varios separados por coma).
# Incluye citas.ferragro y frontend-ferragro; en producción el API también acepta *.ferragro.vercel.app por regex.
CORS_ORIGINS=https://frontend-ferragro.vercel.app,https://citas.ferragro.vercel.app
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=none

# Opcional: correo, Cloudinary, zona horaria
BUSINESS_TIMEZONE=America/Bogota
# Horas mínimas para cancelar cita (proveedor; staff sin rol admin de bodega)
# APPOINTMENT_CANCEL_MINIMUM_NOTICE_HOURS=12

# --- Correo saliente (UN solo servidor SMTP para todo Ferragro) ---
# El sistema envía DESDE este buzón HACIA cualquier destinatario (@gmail, @outlook, @ferragro, etc.).
# El tipo de correo del usuario que inicia sesión NO cambia la configuración: siempre se usa este SMTP.
#
# Opción A — perfil predefinido (rellena host/puerto si SMTP_HOST está vacío):
#   office365 | outlook | gmail | gmail_ssl
SMTP_PROFILE=office365
#
# Opción B — valores explícitos (tienen prioridad sobre el perfil):
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=ebarajas@ferragro.com
SMTP_PASSWORD=contraseña-de-aplicacion-microsoft
SMTP_FROM_EMAIL=ebarajas@ferragro.com
SMTP_FROM_NAME=Ferragro
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# SMTP_REPLY_TO=ecommerce@ferragro.com
#
# Ejemplo Gmail (contraseña de aplicación Google, no la clave normal):
# SMTP_PROFILE=gmail
# SMTP_USER=tu.cuenta@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM_EMAIL=tu.cuenta@gmail.com
#
# Subir SMTP a Render (no commitear la key real):
# RENDER_API_KEY=rnd_...
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-...?key=...
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
