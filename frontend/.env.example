# Variables de build para Vercel (Project Settings -> Environment Variables).
# En local, copia a frontend/.env o usa un .env en la raíz (Vite envDir apunta a ..).
VITE_API_URL=https://tu-api.onrender.com
VITE_API_PREFIX=/api/v1
# Opcional: si coincide con API_BUILD_ID del backend, el banner de API desactualizado no se muestra
# VITE_EXPECTED_API_BUILD_ID=2026-05-28-deploy-main-v1
# Opcional: ms de espera (por defecto 45000 / 90000 al crear citas)
# VITE_API_TIMEOUT_MS=45000
# VITE_API_SLOW_TIMEOUT_MS=90000
# Días que se muestran en el panel (debe coincidir con NOTIFICATION_RETENTION_DAYS del backend)
# VITE_NOTIFICATION_RETENTION_DAYS=30
# Debe coincidir con APPOINTMENT_CANCEL_MINIMUM_NOTICE_HOURS del backend (default 12)
# VITE_APPOINTMENT_CANCEL_MINIMUM_NOTICE_HOURS=12
